#!/usr/bin/env bash
# Runs the quick checks before each commit (scripts/check.sh --quick). Enable it once
# per clone with:
#
#   git config core.hooksPath .githooks
#
# It checks the working tree, not only what is staged. Skip it once with
# git commit --no-verify; the full checks run once anyway, before the merge.
# scripts/check.sh says one line when green (profiles/quiet.sh); CHECK_VERBOSE=1 shows all.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
# What is the project's own: the "env" of .creator.json, exported for scripts/check.sh.
if [ -f "$root/.creator.json" ]; then
	eval "$(python3 -c 'import json, shlex, sys
for k, v in json.load(open(sys.argv[1])).get("env", {}).items():
    print("export %s=%s" % (k, shlex.quote(str(v))))' "$root/.creator.json")"
fi
exec "$root/scripts/check.sh" --quick
