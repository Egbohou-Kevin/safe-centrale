[Unit]
Description=safeHome link agent (hub to cloud)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service
# Restart forever: an alarm that gives up after a few failures is worse than one that keeps trying.
StartLimitIntervalSec=0

[Service]
# The program says when it is ready, then that it still works: a program stuck for
# 30 s is killed with SIGABRT (its goroutines go to the journal) and started again.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=safehome
Group=safehome
ExecStart=/usr/local/bin/safehome-agent run -config /etc/safehome/agent.json
Restart=always
RestartSec=2
# A clean stop sends what is left on the hub, tells the cloud the site goes offline and
# removes the pid file (3 s + 5 s of grace in the program).
TimeoutStopSec=15

# Hardening: the program writes only its state directory (the queue for the cloud).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/safehome
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
PrivateDevices=yes
# Common settings (security study, 28 October 2026): native system calls only, files
# private to safehome (UMask; every reader of them runs as safehome or root), no other
# user's process seen in /proc, the hostname never changed.
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProtectHostname=yes
# Its code reads nothing in /proc but its own process; its /dev is private already,
# so ProtectClock closes no device. It joins the cloud: no IPAddressDeny.
ProcSubset=pid
ProtectClock=yes

[Install]
WantedBy=multi-user.target
