[Unit]
Description=safeHome hub (alarm engine, supervision, escalation)
After=network.target mosquitto.service
Wants=mosquitto.service
# Restart forever: an alarm that gives up after a few failures is worse than one that keeps trying.
StartLimitIntervalSec=0

[Service]
# The program says when it is ready, then that it still works: a program stuck for
# 30 s is killed with SIGABRT (its goroutines go to the journal) and started again.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=safehome
Group=safehome
ExecReload=/bin/kill -HUP $MAINPID
ExecStart=/usr/local/bin/safehome-hub run -config /etc/safehome/hub.json
# Its password on the hub's broker (29 October 2026), root's file, handed to this unit
# alone in $CREDENTIALS_DIRECTORY.
LoadCredential=mqtt-password:/etc/safehome/mqtt/safehome-hub.secret
Restart=always
RestartSec=2
# A clean stop sends what is left and removes the pid file (3 s of grace in the program).
TimeoutStopSec=15

# Hardening: the program writes only its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/safehome
# It sees no file of /etc/safehome but its own (29 October 2026, the security study's
# remark 3): each other one inaccessible, - for a file the site does not have. Not an
# empty folder with its files bound back: it reads hub.json again while it runs (the
# contacts, each configuration from the cloud checked against it), and a bound file
# replaced by rename would stay the old one, in silence.
InaccessiblePaths=-/etc/safehome/agent.json -/etc/safehome/cloud.secret -/etc/safehome/gsm.json
InaccessiblePaths=-/etc/safehome/zigbee.json -/etc/safehome/profiles -/etc/safehome/power.json
InaccessiblePaths=-/etc/safehome/maint.json -/etc/safehome/maint.key -/etc/safehome/maint.key.pub
InaccessiblePaths=-/etc/safehome/maint_known_hosts -/etc/safehome/console.json -/etc/safehome/console.secret
InaccessiblePaths=-/etc/safehome/video.json -/etc/safehome/mqtt
# Nor the Zigbee network's key (29 October 2026): /var/lib/zigbee2mqtt, absent on a hub
# without Zigbee.
InaccessiblePaths=-/var/lib/zigbee2mqtt
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
PrivateDevices=yes
# Common settings (security study, 28 October 2026): native system calls only, files
# private to safehome (UMask; every reader of them runs as safehome or root), no other
# user's process seen in /proc, the hostname never changed.
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProtectHostname=yes
# No ProcSubset: sysclock reads /proc/uptime. No ProtectClock: its filter blocks
# adjtimex, which sysclock calls to read whether NTP has set the clock.
# It speaks to the local broker only.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
