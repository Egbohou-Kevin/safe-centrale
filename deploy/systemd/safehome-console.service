[Unit]
Description=safeHome local console (own Wi-Fi and web page, during the installation mode only)
After=network-online.target mosquitto.service NetworkManager.service
Wants=network-online.target mosquitto.service
# Restart forever: an alarm that gives up after a few failures is worse than one that keeps trying.
StartLimitIntervalSec=0

[Service]
# The program says when it is ready, then that it still works: a program stuck for
# 30 s is killed with SIGABRT (its goroutines go to the journal) and started again.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=safehome
Group=safehome
ExecStart=/usr/local/bin/safehome-console run -config /etc/safehome/console.json
# Its password on the hub's broker (29 October 2026), root's file, handed to this unit
# alone in $CREDENTIALS_DIRECTORY.
LoadCredential=mqtt-password:/etc/safehome/mqtt/safehome-console.secret
Restart=always
RestartSec=2
# A clean stop turns the network off (nmcli) before the program exits.
TimeoutStopSec=40
# The page listens on port 80 of the hub's own network, as an ordinary user: this
# capability and nothing else. NetworkManager makes the network, allowed by the
# polkit rule in deploy/system/polkit-safehome-console.rules.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: the program writes only the state directory (the zones and sirens it
# sets for the hub, and the contacts' access codes, access.json, are kept there).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/safehome
# It sees no file of /etc/safehome but its own (29 October 2026, the security study's
# remark 3): each other one inaccessible, - for a file the site does not have. Not an
# empty folder with its files bound back: it reads hub.json again at each access code
# changed, and a bound file replaced by rename would stay the old one, in silence.
InaccessiblePaths=-/etc/safehome/agent.json -/etc/safehome/cloud.secret -/etc/safehome/gsm.json
InaccessiblePaths=-/etc/safehome/zigbee.json -/etc/safehome/profiles -/etc/safehome/power.json
InaccessiblePaths=-/etc/safehome/maint.json -/etc/safehome/maint.key -/etc/safehome/maint.key.pub
InaccessiblePaths=-/etc/safehome/maint_known_hosts -/etc/safehome/video.json -/etc/safehome/mqtt
# Nor the Zigbee network's key (29 October 2026): /var/lib/zigbee2mqtt, absent on a hub
# without Zigbee.
InaccessiblePaths=-/var/lib/zigbee2mqtt
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryDenyWriteExecute=yes
# Common settings (security study, 28 October 2026): native system calls only, files
# private to safehome (UMask; every reader of them runs as safehome or root), no other
# user's process seen in /proc, the hostname never changed.
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProtectHostname=yes
# No ProcSubset: the hotspot reads /proc/sys/net/ipv4/conf. No ProtectClock: it would
# restrict /dev to a list (DeviceAllow=char-rtc r is implied).

[Install]
WantedBy=multi-user.target
