[Unit]
Description=safeHome remote maintenance (on-demand tunnel to our bastion)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service
# Restart forever: an alarm that gives up after a few failures is worse than one that keeps trying.
StartLimitIntervalSec=0

[Service]
# The program says when it is ready, then that it still works: a program stuck for
# 30 s is killed with SIGABRT (its goroutines go to the journal) and started again.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=safehome
Group=safehome
ExecStart=/usr/local/bin/safehome-maint run -config /etc/safehome/maint.json
# Its password on the hub's broker (29 October 2026), root's file, handed to this unit
# alone in $CREDENTIALS_DIRECTORY.
LoadCredential=mqtt-password:/etc/safehome/mqtt/safehome-maint.secret
Restart=always
RestartSec=2
# A clean stop closes the tunnel and removes the pid file.
TimeoutStopSec=15
# ssh dies with the service: a tunnel never outlives it.
KillMode=control-group

# Hardening: the program writes only its state directory. ssh reads the hub's key and
# the bastion's host key in /etc/safehome, and writes nothing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/safehome
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
# Common settings (security study, 28 October 2026): native system calls only, files
# private to safehome (UMask; every reader of them runs as safehome or root), no other
# user's process seen in /proc, the hostname never changed.
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProtectHostname=yes
# No ProcSubset: ssh runs under it, not yet tried that way on the Pi. No ProtectClock:
# it would restrict /dev to a list.

[Install]
WantedBy=multi-user.target
