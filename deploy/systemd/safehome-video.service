[Unit]
Description=SeQ video service (live sessions through go2rtc)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service
# Restart forever: an alarm that gives up after a few failures is worse than one that keeps trying.
StartLimitIntervalSec=0

[Service]
# The program says when it is ready, then that it still works: a program stuck for
# 30 s is killed with SIGABRT (its goroutines go to the journal) and started again.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=safehome
Group=safehome
ExecStart=/usr/local/bin/safehome-video run -config /etc/safehome/video.json
# Its password on the hub's broker (29 October 2026), root's file, handed to this unit
# alone in $CREDENTIALS_DIRECTORY.
LoadCredential=mqtt-password:/etc/safehome/mqtt/safehome-video.secret
Restart=always
RestartSec=2
# A clean stop ends every go2rtc process; whatever is left in the service's group is
# killed with it (KillMode=control-group, the default), so no stream outlives it.
TimeoutStopSec=15
KillMode=control-group

# Hardening: the program writes only its own state and the photos (below), and
# go2rtc's sockets in a private /tmp.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
# go2rtc and its children use little memory; a runaway one must not starve the alarm.
MemoryMax=200M
# Common settings (security study, 28 October 2026): native system calls only, files
# private to safehome (UMask; every reader of them runs as safehome or root), no other
# user's process seen in /proc, the hostname never changed.
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProtectHostname=yes
# No ProcSubset: go2rtc and ffmpeg run under it, not yet tried that way on the Pi. No
# ProtectClock: its filter blocks adjtimex (sysclock), and it would restrict /dev to a
# list (a camera). go2rtc and ffmpeg see none of /etc/safehome but video.json, and
# none of /var/lib/safehome (code key, access codes) but three folders: an empty
# folder over each, what the program needs bound back (a bind needs its mount point,
# which an InaccessiblePaths= folder cannot hold). video/, its own state (pid file,
# month's usage, outbox), and photos/, which it writes for the agent; site/, the
# configuration from the cloud, read-only: a folder, as the hub replaces the file by
# rename and a bound file would stay the old one. install.sh makes the three.
TemporaryFileSystem=/etc/safehome:ro /var/lib/safehome:ro
BindReadOnlyPaths=/etc/safehome/video.json /var/lib/safehome/site
BindPaths=/var/lib/safehome/video /var/lib/safehome/photos
# Nor the Zigbee network's key (29 October 2026): /var/lib/zigbee2mqtt, absent on a hub
# without Zigbee.
InaccessiblePaths=-/var/lib/zigbee2mqtt

[Install]
WantedBy=multi-user.target
