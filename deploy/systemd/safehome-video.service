[Unit]
Description=safeHome video service (live sessions through go2rtc)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service
# Restart forever: an alarm that gives up after a few failures is worse than one that keeps trying.
StartLimitIntervalSec=0

[Service]
# The program says when it is ready, then that it still works: a program stuck for
# 30 s is killed with SIGABRT (its goroutines go to the journal) and started again.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=safehome
Group=safehome
ExecStart=/usr/local/bin/safehome-video run -config /etc/safehome/video.json
Restart=always
RestartSec=2
# A clean stop ends every go2rtc process; whatever is left in the service's group is
# killed with it (KillMode=control-group, the default), so no stream outlives it.
TimeoutStopSec=15
KillMode=control-group

# Hardening: the program writes only its state directory, and go2rtc's sockets in a
# private /tmp.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/safehome
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
# go2rtc and its children use little memory; a runaway one must not starve the alarm.
MemoryMax=200M
# Common settings (security study, 28 October 2026): native system calls only, files
# private to safehome (UMask; every reader of them runs as safehome or root), no other
# user's process seen in /proc, the hostname never changed.
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProtectHostname=yes
# No ProcSubset: go2rtc and ffmpeg run under it, not yet tried that way on the Pi. No
# ProtectClock: its filter blocks adjtimex (sysclock), and it would restrict /dev to a
# list (a camera). go2rtc and ffmpeg see none of /etc/safehome but video.json: an
# empty folder over it, the file bound back read-only (a bind needs its mount point,
# which an InaccessiblePaths= folder cannot hold). /var/lib/safehome stays open: the
# program locks video.pid there, writes photos/ for the agent and reads
# site-config.json (rewritten by rename, so a bound file would go stale).
TemporaryFileSystem=/etc/safehome:ro
BindReadOnlyPaths=/etc/safehome/video.json

[Install]
WantedBy=multi-user.target
