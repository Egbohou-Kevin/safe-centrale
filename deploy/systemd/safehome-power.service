[Unit]
Description=safeHome battery module (mains and battery of the hub)
After=mosquitto.service
Wants=mosquitto.service
# Restart forever: an alarm that gives up after a few failures is worse than one that keeps trying.
StartLimitIntervalSec=0

[Service]
# The program says when it is ready, then that it still works: a program stuck for
# 30 s is killed with SIGABRT (its goroutines go to the journal) and started again.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=safehome
Group=safehome
# The module's GPIO lines and I2C bus (Raspberry Pi OS gives them to these groups).
SupplementaryGroups=gpio i2c
ExecStart=/usr/local/bin/safehome-power run -config /etc/safehome/power.json
# Its password on the hub's broker (29 October 2026), root's file, handed to this unit
# alone in $CREDENTIALS_DIRECTORY.
LoadCredential=mqtt-password:/etc/safehome/mqtt/safehome-power.secret
Restart=always
# A module that does not answer at start stops the program: try again, without
# filling the journal.
RestartSec=10
TimeoutStopSec=15

# Hardening: the program writes only its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/safehome
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
# Common settings (security study, 28 October 2026): native system calls only, files
# private to safehome (UMask; every reader of them runs as safehome or root), no other
# user's process seen in /proc, the hostname never changed.
SystemCallArchitectures=native
UMask=0077
ProtectProc=invisible
ProtectHostname=yes
# Its code reads nothing in /proc but its own process. No ProtectClock: it would
# restrict /dev to a list and close the module's GPIO lines and I2C bus.
# It speaks to the local broker only.
ProcSubset=pid
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
