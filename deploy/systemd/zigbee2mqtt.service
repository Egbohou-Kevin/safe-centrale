[Unit]
Description=Zigbee2MQTT (bridge between the Zigbee stick and the broker)
After=network.target mosquitto.service
Wants=mosquitto.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=safehome
Group=safehome
# The Zigbee stick's serial port.
SupplementaryGroups=dialout
WorkingDirectory=/opt/zigbee2mqtt
# Its data (network key, devices) lives on the writable partition.
Environment=ZIGBEE2MQTT_DATA=/var/lib/zigbee2mqtt
Environment=NODE_ENV=production
# Its name and password on the hub's broker (29 October 2026), root's file read by
# systemd: they win over configuration.yaml, which Zigbee2MQTT rewrites itself.
EnvironmentFile=/etc/safehome/mqtt/zigbee2mqtt.env
ExecStart=/usr/bin/node /opt/zigbee2mqtt/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# Hardening (security study, 28 October 2026): a third-party Node program writes only
# its data folder (ZIGBEE2MQTT_DATA above) and never sees our secrets. /dev stays whole
# for the stick (no PrivateDevices, DevicePolicy, DeviceAllow nor ProtectClock): deaf
# sensors are an alarm that does not ring.
ProtectSystem=strict
ReadWritePaths=/var/lib/zigbee2mqtt
InaccessiblePaths=/etc/safehome /var/lib/safehome

[Install]
WantedBy=multi-user.target
