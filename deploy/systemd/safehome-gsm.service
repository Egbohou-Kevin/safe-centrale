[Unit]
Description=safeHome GSM gateway (SMS and calls)
After=network.target mosquitto.service
Wants=mosquitto.service
# Restart forever: an alarm that gives up after a few failures is worse than one that keeps trying.
StartLimitIntervalSec=0

[Service]
# The program says when it is ready, then that it still works: a program stuck for
# 30 s is killed with SIGABRT (its goroutines go to the journal) and started again.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=safehome
Group=safehome
# The modem's serial port.
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/safehome-gsm run -config /etc/safehome/gsm.json
Restart=always
RestartSec=2
# A clean stop sends what is left and removes the pid file (3 s of grace in the program).
TimeoutStopSec=15

# Hardening: the program writes only its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/safehome
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
