// /etc/polkit-1/rules.d/50-safehome-console.rules
// The local console (user safehome) makes and removes the hub's own Wi-Fi network
// through NetworkManager, during the installation mode only (docs/security-install.md).
// Only the actions nmcli needs for that (connection add, up, down, delete): never the
// radio on or off, nor sleeping the machine.
//
// What it grants goes beyond the console: polkit knows the user, not the program, and
// every service of ours runs as safehome. settings.modify.system lets such a process
// read and change any system connection, the box's Wi-Fi and its password included,
// and network-control lets it take a connection down. A network owned by safehome
// alone (settings.modify.own) would need a login session NetworkManager can see,
// which a service has not.
polkit.addRule(function(action, subject) {
    if (subject.user !== "safehome") {
        return polkit.Result.NOT_HANDLED;
    }
    switch (action.id) {
    case "org.freedesktop.NetworkManager.settings.modify.system":
    case "org.freedesktop.NetworkManager.network-control":
    case "org.freedesktop.NetworkManager.wifi.share.protected":
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
