{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alarm-ack.json",
  "title": "alarm.ack",
  "description": "Ne contient jamais le code.",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "description": "id de l'ordre"
    },
    "status": {
      "type": "string",
      "enum": [
        "done",
        "refused",
        "expired",
        "failed"
      ],
      "description": "expired : l'ordre est arrivé après son exp et n'a pas été exécuté (réponse du moteur, ou de l'agent de liaison pour un ordre venu du cloud)."
    },
    "reason": {
      "type": "string",
      "enum": [
        "zone_open",
        "bad_code",
        "locked_out",
        "wrong_state",
        "postpone_limit",
        "unknown_command",
        "rate_limited"
      ],
      "description": "rate_limited : refusé par l'agent de liaison, au-delà de sa limite de messages du cloud ; la centrale ne l'a pas reçu."
    },
    "detail": {
      "type": "object"
    }
  },
  "required": [
    "ref",
    "status"
  ]
}
