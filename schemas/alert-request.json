{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alert-request.json",
  "title": "alert.request",
  "type": "object",
  "properties": {
    "incident": {
      "type": "string",
      "minLength": 1
    },
    "incident_at": {
      "type": "string",
      "format": "date-time",
      "description": "Heure de l'incident (UTC, à la milliseconde), la même à chaque vague et à chaque relance ; le ts de l'enveloppe est l'heure de la demande"
    },
    "zone": {
      "type": "string",
      "minLength": 1,
      "description": "Fuseau horaire IANA du site (Africa/Lome), pour lire incident_at à l'heure du site"
    },
    "kind": {
      "type": "string",
      "enum": [
        "intrusion",
        "fire",
        "panic",
        "tamper",
        "auth_failed",
        "battery_low_hub",
        "mains_restored",
        "device_offline",
        "battery_low",
        "arming_bypassed",
        "gsm_degraded",
        "zigbee_down",
        "siren_failed"
      ]
    },
    "urgency": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "low"
      ]
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Niveau de batterie, pour les alertes de batterie"
    },
    "wave": {
      "type": "integer",
      "minimum": 0
    },
    "contact": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "app",
        "whatsapp",
        "sms",
        "call"
      ]
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "incident",
    "incident_at",
    "zone",
    "kind",
    "urgency"
  ]
}
