{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/gsm-status.json",
  "title": "gsm.status",
  "description": "Lignes de la passerelle GSM, retenu, publié à chaque changement",
  "type": "object",
  "properties": {
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "type": "string"
          },
          "responding": {
            "type": "boolean",
            "description": "Le modem répond"
          },
          "registered": {
            "type": "boolean"
          },
          "signal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "credit": {
            "type": "string"
          },
          "last_test": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, à la milliseconde"
          },
          "last_test_ok": {
            "type": "boolean"
          },
          "restarts": {
            "type": "integer",
            "minimum": 0,
            "description": "Redémarrages du modem depuis le lancement de la passerelle"
          }
        },
        "required": [
          "id",
          "responding",
          "registered",
          "signal"
        ]
      }
    },
    "queued": {
      "type": "integer",
      "minimum": 0,
      "description": "SMS et appels en attente"
    }
  },
  "required": [
    "lines",
    "queued"
  ]
}
