{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alarm-command.json",
  "title": "alarm.command",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "alarm.arm, alarm.arm_now, alarm.disarm, alarm.silence, alarm.bypass, alarm.postpone"
    },
    "args": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{4,8}$",
          "description": "Code d'accès : 4 à 8 chiffres ASCII, rien d'autre (la règle de la centrale). Jamais écrit dans un journal, jamais renvoyé."
        },
        "sealed": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{147}=$",
          "description": "Le code scellé par le téléphone pour l'agent de liaison (ECIES P-256, voir contract.md) : tout ce que le cloud porte. L'agent l'ouvre et donne au moteur `code`, jamais `sealed`."
        },
        "force": {
          "type": "boolean"
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "origin": {
      "type": "string",
      "enum": [
        "keypad",
        "app",
        "schedule"
      ]
    },
    "user": {
      "type": "string"
    },
    "exp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC, à la milliseconde"
    }
  },
  "required": [
    "command",
    "args",
    "origin"
  ]
}
