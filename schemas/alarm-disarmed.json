{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alarm-disarmed.json",
  "title": "alarm.disarmed",
  "type": "object",
  "properties": {
    "origin": {
      "type": "string",
      "enum": [
        "keypad",
        "app",
        "schedule"
      ]
    },
    "user": {
      "type": "string"
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Les incidents que ce désarmement termine : l'alarme qui sonne, et les intrusions et sabotages de l'armement dont la sirène s'est déjà arrêtée seule ; vide s'il n'en termine aucun"
    }
  },
  "required": [
    "origin",
    "incidents"
  ]
}
