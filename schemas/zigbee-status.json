{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/zigbee-status.json",
  "title": "zigbee.status",
  "description": "État du réseau Zigbee, retenu, publié à chaque changement et répété chaque minute",
  "type": "object",
  "properties": {
    "bridge": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ],
      "description": "Zigbee2MQTT et sa clé"
    },
    "devices": {
      "type": "integer",
      "minimum": 0
    },
    "offline": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pairing": {
      "type": "boolean"
    }
  },
  "required": [
    "bridge",
    "devices",
    "offline",
    "pairing"
  ]
}
