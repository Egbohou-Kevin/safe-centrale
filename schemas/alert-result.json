{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alert-result.json",
  "title": "alert.result",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "ref",
    "status"
  ]
}
