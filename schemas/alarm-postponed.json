{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alarm-postponed.json",
  "title": "alarm.postponed",
  "description": "L'armement automatique est reporté.",
  "type": "object",
  "properties": {
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "UTC, à la milliseconde"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "max": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "scheduled_for",
    "count",
    "max"
  ]
}
