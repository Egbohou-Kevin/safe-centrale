{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alarm-triggered.json",
  "title": "alarm.triggered",
  "type": "object",
  "properties": {
    "incident": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "device_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "Nom de l'appareil dans la configuration du site, absent s'il n'en a pas"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "zone": {
      "type": "string"
    }
  },
  "required": [
    "incident",
    "device_id",
    "capability",
    "zone"
  ]
}
