{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/registry-snapshot.json",
  "title": "registry.snapshot",
  "description": "Liste des appareils, retenue sur registry/devices.",
  "type": "object",
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "device_id",
          "model",
          "capabilities",
          "adapter"
        ]
      }
    }
  },
  "required": [
    "devices"
  ]
}
