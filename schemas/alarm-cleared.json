{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alarm-cleared.json",
  "title": "alarm.cleared",
  "type": "object",
  "properties": {
    "incident": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "user",
        "timeout"
      ]
    },
    "user": {
      "type": "string"
    },
    "duration_s": {
      "type": "integer",
      "minimum": 0
    },
    "ended": {
      "type": "boolean",
      "description": "Présent et vrai quand une personne a terminé l'alarme avec alarm.end, le local toujours armé, que sa sirène sonne encore ou se soit déjà arrêtée seule (duration_s vaut alors 0 : sa durée a été dite quand elle s'est arrêtée)"
    }
  },
  "required": [
    "incident",
    "origin",
    "duration_s"
  ]
}
