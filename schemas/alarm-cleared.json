{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehome.example/schemas/alarm-cleared.json",
  "title": "alarm.cleared",
  "type": "object",
  "properties": {
    "incident": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "user",
        "timeout"
      ]
    },
    "user": {
      "type": "string"
    },
    "duration_s": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "incident",
    "origin",
    "duration_s"
  ]
}
