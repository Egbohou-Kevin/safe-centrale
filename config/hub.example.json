{
  "site": "tg-lom-0001",
  "broker_url": "mqtt://127.0.0.1:1883",
  "client_id": "safehome-hub-tg-lom-0001",
  "state_dir": "/var/lib/safehome",
  "log_level": "info",
  "timezone": "Africa/Lome",

  "site_name": "Boutique Lome",

  "contacts": [
    { "id": "u_owner", "name": "Proprietaire", "role": "owner",   "channels": ["app", "whatsapp", "sms", "call"] },
    { "id": "u_deputy", "name": "Responsable", "role": "deputy",  "channels": ["app", "sms", "call"] },
    { "id": "u_guard", "name": "Gardien",      "role": "guard",   "channels": ["sms", "call"] },
    { "id": "u_mgr",   "name": "Gerant",       "role": "manager", "channels": ["app", "sms"] }
  ],

  "escalation": {
    "internet_confirm": "10s",
    "gsm_delay": "1m",
    "max_per_hour": 20,
    "plans": {
      "intrusion": {
        "waves": [
          { "after": "0s", "to": ["first", "guard"],          "double": true },
          { "after": "2m", "to": ["owner", "guard", "first"], "double": true },
          { "after": "5m", "to": ["rest"],                    "double": true }
        ],
        "repeat": { "every": "10m", "times": 3 }
      },
      "fire":  { "waves": [{ "to": ["everyone"], "sms_now": true, "double": true }], "repeat": { "every": "10m", "times": 3 } },
      "panic": { "waves": [{ "to": ["everyone"], "sms_now": true, "double": true }], "repeat": { "every": "10m", "times": 3 } },

      "tamper":          { "waves": [{ "to": ["first"], "double": true }] },
      "auth_failed":     { "waves": [{ "to": ["first"], "double": true }] },
      "arming_bypassed": { "waves": [{ "to": ["first"], "double": true }] },
      "battery_low_hub": { "waves": [{ "to": ["first"], "double": true }] },
      "zigbee_down":     { "waves": [{ "to": ["first"], "double": true }] },
      "siren_failed":    { "waves": [{ "to": ["first", "guard"], "double": true }] },

      "mains_restored": { "waves": [{ "to": ["first"] }], "internet_only": true, "gsm_after": "1h" },
      "device_offline": { "waves": [{ "to": ["owner"] }], "internet_only": true },
      "battery_low":    { "waves": [{ "to": ["owner"] }], "internet_only": true },
      "gsm_degraded":   { "waves": [{ "to": ["owner"] }], "internet_only": true }
    }
  },

  "hub_device_id": "dev_hubpower",
  "siren_ids": ["dev_siren1"],

  "zones": {
    "dev_door":   { "name": "Entree",        "kind": "entry" },
    "dev_back":   { "name": "Porte arriere", "kind": "instant" },
    "dev_window": { "name": "Vitrine",       "kind": "instant" },
    "dev_motion": { "name": "Boutique",      "kind": "interior" },
    "dev_smoke":  { "name": "Fumee",         "kind": "24h_fire" },
    "dev_panic":  { "name": "Comptoir",      "kind": "24h_panic" },
    "dev_tamper": { "name": "Centrale",      "kind": "24h_tamper" }
  },

  "closing": { "daily": "20:00", "sun": "off", "sat": "18:00" },

  "alarm": {
    "exit_delay": "2m",
    "entry_delay": "45s",
    "siren_cycle": "5m",
    "siren_pause": "2m",
    "siren_cycles": 3,
    "lockout_attempts": 3,
    "lockout_duration": "10m",
    "panic_siren": false,
    "auto_arm_notice": "10m",
    "postpone_step": "30m",
    "postpone_max": 3,
    "auto_arm_limit": "2h"
  },

  "health": {
    "hub_battery_warn": 40,
    "hub_battery_critical": 10,
    "hub_battery_rearm": 60,
    "device_battery_low": 15,
    "device_battery_rearm": 30,
    "summary_at": "09:00",
    "gsm_degraded_after": "10m",
    "gsm_silent_after": "3m",
    "zigbee_silent_after": "3m",
    "zigbee_down_after": "3m",
    "internet_silent_after": "3m"
  },

  "access": { "iterations": 200000 },

  "heartbeat_every": "1m",
  "boot_window": "2s"
}
